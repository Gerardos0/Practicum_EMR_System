# Copy this file to .env and fill in real values.
# Never commit .env — it's gitignored on purpose.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://emr:emr@localhost:5432/emr

# --- Backend ---
BACKEND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Frontend (Vite reads only VITE_ prefixed vars, baked in at build time) ---
VITE_API_URL=http://localhost:8000