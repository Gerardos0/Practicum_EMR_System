# Combined reference. The processes do not read this file.
# Backend reads backend/.env (copy backend/.env.example).
# Frontend reads frontend/.env (copy frontend/.env.example).
# Never commit a filled-in .env.

# --- Database (async driver; Alembic derives the sync psycopg2 URL) ---
DATABASE_URL=postgresql+asyncpg://emr:emr@localhost:5432/emr

# --- Backend ---
ENVIRONMENT=development
JWT_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Frontend (Vite bakes VITE_ vars in at build time) ---
VITE_API_URL=http://localhost:8000
