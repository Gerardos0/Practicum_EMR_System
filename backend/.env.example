# Copy to backend/.env. The API reads this file when started from backend/.
# Never commit .env.

ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://emr:emr@localhost:5432/emr
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Password for the synthetic demo accounts created by app.scripts.seed. Not used in production.
SEED_DEMO_PASSWORD=practicum-demo
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=["http://localhost:5173"]
# Set on Render so Vercel preview URLs are allowed. Leave unset locally.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
